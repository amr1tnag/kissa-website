---
import { media, type Film } from '../data/films';
interface Props {
  film: Film;
  size?: 'big' | 'third' | 'nine' | 'normal';
}
const { film, size = 'normal' } = Astro.props;
const m = media(film.slug);
const cls = ['film', film.vertical ? 'vert' : size === 'normal' ? '' : size].join(' ');
---
<button
  class={cls}
  data-film
  data-src={m.full}
  data-loop={m.loop}
  data-title={`${film.title} · ${film.category}`}
  data-cursor="Play"
  data-reveal
>
  <span class="film-frame">
    <img src={m.poster} alt="" loading="lazy" decoding="async" />
    <video muted loop playsinline preload="none" aria-hidden="true"></video>
    <span class="film-tag">[ {film.category.toUpperCase()} ]</span>
    <span class="film-play" aria-hidden="true">
      <svg width="18" height="20" viewBox="0 0 18 20"><path d="M2 1.5v17L16.5 10z" fill="currentColor"></path></svg>
    </span>
  </span>
  <span class="film-info">
    <span class="film-title">{film.title}</span>
    <span class="film-meta">{film.duration}</span>
  </span>
  <span class="sr-only">Play film</span>
</button>
